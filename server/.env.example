# Server Network Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# 32-byte (64 hex characters) AES-256-GCM encryption key for securely storing NWC connection URIs at rest
# Generate one using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SERVER_ENCRYPTION_KEY=

# SQLite Database Storage Location
SQLITE_DB_PATH=./data/soundbox.db

