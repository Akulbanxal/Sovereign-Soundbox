# Paste a receive-only NIP-47 NWC connection string with make_invoice and lookup_invoice permissions.
# Format: nostr+walletconnect://<wallet-pubkey>?relay=<relay-url>&secret=<secret>
# NEVER commit .env to version control or share this secret URI.
NWC_TEST_URI=

# CoinGecko Demo API Key (optional, if using an account key for rate-limiting relief)
COINGECKO_DEMO_API_KEY=

